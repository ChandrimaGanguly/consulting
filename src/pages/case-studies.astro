---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';

const base = import.meta.env.BASE_URL;

const caseStudies = [
  {
    id: 'financial-services',
    title: 'Gen AI Guardrails System',
    org: "UK's Largest Retail Bank (Lloyds Banking Group)",
    sector: 'Financial Services',
    service: 'Agentic Safety · GenAI at Scale',
    image: 'https://images.unsplash.com/photo-1541354329998-f4d9a9f9297f?w=800&auto=format&fit=crop&q=80',
    teaser: 'Designed and tech-led the Gen AI Assurance framework and Guardrails toolkit for the UK\'s largest retail bank — covering 50+ AI implementations.',
    challenge: 'A top-5 UK bank was rolling out a GenAI strategy across 50+ implementations but had no unified assurance framework. Each team was making different safety decisions. The board needed something auditable. The regulators needed something defensible. The developers needed something they could actually use.',
    approach: 'Designed the full Gen AI Assurance framework by grouping AI implementations by use case context and GenAI technology used. Implemented a centralised Gen AI Guardrails service deployable out-of-box by all developers, with an inner-source contribution model so technical users could extend and improve the toolkit. Upskilled technical and non-technical roles through workshops and seminars.',
    solution: 'Full Gen AI Assurance framework covering risk classification, eval standards, monitoring requirements, and compliance documentation templates. Production Gen AI Guardrails toolkit: centralised service covering hallucination detection, output filtering, safety layers, and bias monitoring. Data Science Lifecycle framework: unified responsible AI development standards across the organisation.',
    impact: '£20M of value unlocked across GenAI implementations. DataIQ Best Responsible AI Program Award 2025. Novel fairness monitoring methodology (patent pending).',
  },
  {
    id: 'vida-ethical-ai',
    title: 'Safety & Evaluation Framework for High-Stakes LLM Deployment',
    org: 'herEthicalAI (Vida)',
    sector: 'AI Safety',
    service: 'Adversarial Eval · High-Stakes Deployment',
    image: 'https://images.unsplash.com/photo-1573165349168-b66c8bc087fc?q=80&w=1169&auto=format&fit=crop&ixlib=rb-4.1.0',
    teaser: 'Designing the eval harness and adversarial eval tooling for an LLM system deployed to police forces that detects victim-blaming language in court documents.',
    challenge: 'Vida is an LLM-based system that detects victim-blaming language and coercive abuse patterns in court documents. It\'s deployed to police forces, financial regulators, and abuse survivors. A false negative — missing an instance of victim-blaming — has direct harm consequences for a real person in a vulnerable situation. Standard eval approaches are insufficient for this level of stakes.',
    approach: 'Designed a safety and evaluation framework from first principles for a domain where the cost of failure is measured in harm to survivors. Red-teaming and adversarial eval tooling systematically surface false negatives before deployment. Calibration framework ensures confidence scores are meaningful to operators, not just technically correct.',
    solution: 'Core safety and evaluation framework design. Red-teaming and adversarial eval tooling: systematic attempts to surface false negatives before deployment. Calibration framework: ensuring the system\'s confidence scores are meaningful and not misleading to operators. Failure mode taxonomy: classification of the ways the system can fail and what each means for a survivor, a police officer, a court.',
    impact: 'In progress. Framework designed. Adversarial eval tooling in development.',
  },
  {
    id: 'diverse-ai',
    title: 'Participatory AI Evaluation Framework',
    org: 'Diverse AI (UK NGO)',
    sector: 'Non-Profit',
    service: 'AI Strategy · Participatory Governance',
    image: 'https://images.unsplash.com/photo-1573165349168-b66c8bc087fc?q=80&w=1169&auto=format&fit=crop',
    teaser: 'Built a participatory evaluation framework allowing communities from marginalised backgrounds to directly test open-source GenAI models — and published the methodology.',
    challenge: 'A UK-based NGO focused on diversity in tech wanted to use AI tooling to amplify its mission — but needed to know whether open-source GenAI models actually served communities from marginalised backgrounds before deploying them. No off-the-shelf framework existed for participatory evaluation at scale.',
    approach: 'Designed a research programme that flipped the usual evaluation dynamic: instead of researchers testing models, people from marginalised communities tested models on tasks that actually mattered to them. Crowd-sourced real-world tasks, not synthetic benchmarks.',
    solution: 'Research programme allowing people from marginalised communities to directly evaluate open-source GenAI models through structured participatory methods. Participatory evaluation framework and database: testing GenAI model performance on crowd-sourced real-world tasks from diverse communities. Research methodology bridging technical AI evaluation with qualitative community feedback.',
    impact: 'Programme funded within its first year of operation. Research published: "Bringing AI Participation Down to Scale," Patterns (Cell Press, 2025). Ongoing Inclusive AI in Education initiative.',
  },
  {
    id: 'public-sector-compliance',
    title: 'EU AI Act Regulatory Sandbox Design',
    org: 'EU Parliamentary Organisation',
    sector: 'Public Sector',
    service: 'Regulatory Compliance · Technical Standards',
    image: 'https://images.unsplash.com/photo-1555421689-d68471e189f2?w=800&auto=format&fit=crop&q=80',
    teaser: 'Designed a technically implementable regulatory sandbox for AI applications under the EU AI Act — not a policy document, but a framework you could actually use.',
    challenge: 'An EU Parliamentary organisation needed to design a regulatory sandbox for AI applications falling under the EU AI Act — not a policy document, but a technically implementable framework that could be used to demonstrate compliance and test AI systems in a controlled environment.',
    approach: 'Focused on reusable metrics, automated AI observability and monitoring, and human-in-the-loop integration where required by the Act\'s risk classification. Tiered requirements by EU AI Act risk level (High / Limited / Minimal) to make compliance proportionate and practical.',
    solution: 'General AI observability and monitoring requirements spec (reusable, automated). Standard fairness and explainability metric reporting framework, tiered by EU AI Act risk classification. Human-in-the-loop integration requirements for High-Risk AI systems. Regulatory sandbox design with measurable compliance checkpoints.',
    impact: 'Regulatory sandbox design integrated into official consultation results.',
  },
  {
    id: 'automated-monitoring',
    title: 'Automated Fairness Monitoring for Public Sector AI',
    org: 'Public Sector Technology Company',
    sector: 'Responsible AI Implementation',
    service: 'Fairness Monitoring · Technical Research',
    image: 'https://images.unsplash.com/photo-1551288049-bebda4e38f71?w=800&auto=format&fit=crop&q=80',
    teaser: 'Built a novel automated fairness monitoring protocol using semi-supervised learning to track changes in marginalised groups as social context evolves over time.',
    challenge: 'A technology company serving UK public sector clients was concerned that their AI applications were continuing to discriminate against marginalised groups — particularly as the social definition of marginalised groups evolves over time. Static bias monitoring was insufficient because it couldn\'t adapt as society changes.',
    approach: 'Looked outside the conventional fairness monitoring toolkit and found the solution in a different field of AI: semi-supervised learning. Re-formulated the problem in that context to design an automated monitoring protocol that doesn\'t require the definition of marginalised groups to be fixed at development time.',
    solution: 'Novel automated fairness monitoring protocol drawing on semi-supervised learning methods applied to AI safety. System tracks changes in the social positions of groups identified as marginalised during AI application development — automatically adapting as social context shifts. Catches distributional drift in protected characteristics before it causes harm.',
    impact: 'Method implemented in the technology strategy of the public services technology team for further incorporation and R&D.',
  },
];

const sectors = ['All', 'Financial Services', 'AI Safety', 'Non-Profit', 'Public Sector', 'Responsible AI Implementation'];
---

<BaseLayout
  title="Case Studies"
  description="Production AI safety systems, guardrails, and evals built by Chandrima Ganguly. Lloyds Banking Group, herEthicalAI, Diverse AI, EU Parliamentary organisations."
>
  <!-- Hero Section -->
  <section class="section-padding bg-gradient-to-b from-warm-stone/50 to-soft-cream">
    <div class="container-wide mx-auto">
      <div class="max-w-3xl">
        <p class="text-terracotta text-sm tracking-widest uppercase mb-4">Case Studies</p>
        <h1 class="mb-6">What I've shipped.</h1>
        <p class="text-xl text-deep-earth/80 leading-relaxed">
          Production systems, not strategy decks. Here's what I've built, how I built it, and what happened.
        </p>
      </div>
    </div>
  </section>

  <!-- Filter (visual only) -->
  <section class="py-8 border-b border-warm-stone">
    <div class="container-wide mx-auto px-6 md:px-8">
      <div class="flex flex-wrap gap-3 justify-center">
        {sectors.map((sector, index) => (
          <button
            class={`px-4 py-2 rounded-full text-sm font-medium transition-colors ${
              index === 0
                ? 'bg-forest-deep text-soft-cream'
                : 'bg-warm-stone/50 text-deep-earth hover:bg-sage/20'
            }`}
          >
            {sector}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Case Studies Grid -->
  <section class="section-padding">
    <div class="container-wide mx-auto">
      <p class="text-center text-deep-earth/60 mb-8 text-sm">Click on any card to see the full details</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {caseStudies.map((study, index) => (
          <div class="flip-card h-[700px]" data-card-id={index}>
            <div class="flip-card-inner">
              <!-- Front of card -->
              <article class="flip-card-front card cursor-pointer px-5 pt-5 pb-[0.2px] flex flex-col">
                <!-- Case study image -->
                <div class="rounded-xl mb-4 overflow-hidden flex-shrink-0" style="height: 300px;">
                  <img
                    src={study.image}
                    alt={study.title}
                    class="w-full h-full object-cover"
                  />
                </div>

                <!-- Tags -->
                <div class="flex flex-wrap gap-2 mb-3 flex-shrink-0">
                  <span class="text-sm bg-sage/20 text-forest-deep px-3 py-1 rounded-full">
                    {study.sector}
                  </span>
                  <span class="text-sm bg-terracotta/20 text-terracotta px-3 py-1 rounded-full">
                    {study.service}
                  </span>
                </div>

                <!-- Content -->
                <h2 class="text-xl font-heading font-semibold text-forest-deep mb-1 leading-tight flex-shrink-0">
                  {study.title}
                </h2>
                <p class="text-sm text-sage mb-2 flex-shrink-0">{study.org}</p>
                <p class="text-deep-earth/70 mb-3 text-base leading-snug flex-shrink-0">
                  {study.teaser}
                </p>

                <!-- Challenge preview -->
                <div class="pt-3 border-t border-warm-stone flex-1 overflow-hidden pb-6">
                  <p class="text-base text-deep-earth/60 leading-snug line-clamp-4">
                    <span class="font-semibold text-forest-deep">The situation:</span> {study.challenge}
                  </p>
                </div>

                <!-- Click hint -->
                <div class="absolute bottom-[0.2px] right-5 text-sage/60 text-sm flex items-center gap-1">
                  <span>Click for details</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                </div>
              </article>

              <!-- Back of card -->
              <article class="flip-card-back card cursor-pointer bg-forest-deep text-soft-cream overflow-hidden px-5 pt-5 pb-[0.2px]">
                <div class="h-full flex flex-col">
                  <!-- Header -->
                  <div class="mb-4 flex-shrink-0">
                    <h2 class="text-xl font-heading font-semibold text-soft-cream mb-1 leading-tight">
                      {study.title}
                    </h2>
                    <p class="text-sage text-sm mb-3">{study.org}</p>
                    <div class="flex flex-wrap gap-2">
                      <span class="text-sm bg-sage/30 text-soft-cream px-3 py-1 rounded-full">
                        {study.sector}
                      </span>
                    </div>
                  </div>

                  <!-- Content sections - scrollable -->
                  <div class="flex-1 overflow-y-auto space-y-3 pr-1 custom-scrollbar min-h-0 mb-1">
                    <div>
                      <h3 class="text-sage text-sm tracking-wide uppercase mb-2 font-semibold">What I built</h3>
                      <p class="text-soft-cream/90 text-base leading-snug">{study.solution}</p>
                    </div>

                    <div class="bg-soft-cream/10 rounded-lg p-3 border border-soft-cream/20">
                      <h3 class="text-morning-gold text-sm tracking-wide uppercase mb-2 font-semibold">The outcome</h3>
                      <p class="text-soft-cream text-base leading-snug font-medium">{study.impact}</p>
                    </div>
                  </div>

                  <!-- Click hint -->
                  <div class="text-sage/80 text-sm flex items-center gap-1 justify-center flex-shrink-0">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                    </svg>
                    <span>Click to return</span>
                  </div>
                </div>
              </article>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <style>
    .flip-card {
      perspective: 1000px;
    }

    .flip-card-inner {
      position: relative;
      width: 100%;
      height: 100%;
      transition: transform 0.6s;
      transform-style: preserve-3d;
    }

    .flip-card.flipped .flip-card-inner {
      transform: rotateY(180deg);
    }

    .flip-card-front,
    .flip-card-back {
      position: absolute;
      width: 100%;
      height: 100%;
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
    }

    .flip-card-back {
      transform: rotateY(180deg);
    }

    .custom-scrollbar::-webkit-scrollbar {
      width: 6px;
    }

    .custom-scrollbar::-webkit-scrollbar-track {
      background: rgba(255, 255, 255, 0.1);
      border-radius: 3px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: rgba(180, 203, 176, 0.5);
      border-radius: 3px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: rgba(180, 203, 176, 0.7);
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const flipCards = document.querySelectorAll('.flip-card');

      flipCards.forEach(card => {
        card.addEventListener('click', () => {
          card.classList.toggle('flipped');
        });
      });
    });
  </script>

  <!-- Closing CTA -->
  <section class="section-padding">
    <div class="container-narrow mx-auto text-center">
      <h2 class="mb-6">Ready to be the next case study?</h2>
      <p class="text-xl text-deep-earth/80 mb-8 max-w-2xl mx-auto">
        Every engagement starts with a 30-minute call. I'll tell you honestly whether I can help and what it would look like.
      </p>
      <a href={`${base}/contact`} class="btn-primary">
        Book a call
      </a>
    </div>
  </section>
</BaseLayout>
