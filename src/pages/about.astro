---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';

const base = import.meta.env.BASE_URL;

const principles = [
  {
    title: 'Safety is an engineering problem, not a policy one.',
    description: 'Guardrails, evals, and monitoring are engineering artefacts. They need to be designed, implemented, tested, and maintained. "Responsible AI" as a set of principles doesn\'t help you if your agent is hallucinating in production.',
  },
  {
    title: 'Evals are the thing most teams skip, and it always costs them.',
    description: 'An eval harness is boring to build. It is also the only way to know if your system is behaving as intended at scale. I build them before they\'re needed, not after something breaks.',
  },
  {
    title: 'Physics is the best background for AI safety.',
    description: 'Working with uncertainty is the core skill. My PhD wasn\'t in AI — it was in cosmology and applied ML, which means I spent years quantifying what you don\'t know and building systems that remain useful despite it. That\'s evals. That\'s safety. That\'s calibration.',
  },
  {
    title: 'Fractional means embedded, not advisory.',
    description: 'I don\'t write reports. I sit with your engineers, design the infrastructure with them, build it alongside them, and ship it. The goal is to make your team better at this — not to create dependency on me.',
  },
];

const experience = [
  {
    org: 'Lloyds Banking Group',
    period: '2023–2025',
    role: 'Tech Lead, Responsible AI & GenAI',
    bullets: [
      'Designed and tech-led the production Gen AI Guardrails and Assurance framework',
      'Technical specification covering eval harnesses, safety layers, hallucination monitoring, compliance documentation',
      'System scaled to cover 50+ AI implementations across the UK\'s largest retail bank',
      'Outcome: £20M value unlocked; DataIQ Best Responsible AI Program award 2025',
      'Built the Data Science Lifecycle framework; designed novel fairness monitoring methodologies (patents pending)',
    ],
  },
  {
    org: 'herEthicalAI',
    period: '2026–present',
    role: 'AI Safety & Evaluation Lead (part-time)',
    bullets: [
      'Building safety and evaluation infrastructure for Vida — an LLM system that detects victim-blaming language and coercive abuse patterns in court documents',
      'Deployed to police forces, financial regulators, and abuse survivors',
      'Designing the core eval harness and adversarial eval tooling for a domain where false negatives have direct harm consequences',
    ],
  },
  {
    org: 'Diverse AI',
    period: '2022–2023',
    role: 'Research Lead',
    bullets: [
      'Led participatory AI governance research with multi-stakeholder communities',
      'Built participatory evaluation framework for open-source GenAI models',
      'Published: "Bringing AI Participation Down to Scale," Patterns (Cell Press, 2025)',
      'Funded programme, research paper, ongoing Inclusive AI in Education initiative',
    ],
  },
  {
    org: 'Fujitsu Research Europe',
    period: '2022–2023',
    role: 'Senior Research Scientist',
    bullets: [
      'Technical lead on client-facing AI projects',
      'EU AI Act advisory for a parliamentary organisation (risk classification, documentation, regulatory sandbox design)',
      'Contributed to AI4People (EU) — international AI ethics and governance engagement',
      'Fairness monitoring + privacy-preserving ML approaches (patents pending)',
    ],
  },
];
---

<BaseLayout
  title="About"
  description="Chandrima Ganguly — Fractional AI Architect who designed the Gen AI Guardrails system that unlocked £20M at the UK's largest bank. Available 2–3 days/week, fully remote."
>
  <!-- Hero Section -->
  <section class="section-padding bg-gradient-to-b from-warm-stone/50 to-soft-cream">
    <div class="container-wide mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <!-- Image -->
        <div class="order-2 lg:order-1">
          <div class="relative">
            <div class="aspect-[4/5] rounded-2xl overflow-hidden shadow-2xl">
              <img
                src={`${base}/images/professional_photo.jpg`}
                alt="Dr. Chandrima Ganguly"
                class="w-full h-full object-cover"
              />
            </div>
            <div class="absolute -bottom-6 -right-6 w-32 h-32 bg-sage/20 rounded-2xl -z-10"></div>
            <div class="absolute -top-6 -left-6 w-24 h-24 bg-morning-gold/20 rounded-2xl -z-10"></div>
          </div>
        </div>

        <!-- Content -->
        <div class="order-1 lg:order-2">
          <p class="text-terracotta text-sm tracking-widest uppercase mb-4">About</p>
          <h1 class="mb-6">I build the systems that make AI safe to ship.</h1>
          <p class="text-xl text-deep-earth/80 leading-relaxed mb-6">
            I'm not a strategy consultant who recommends safety frameworks. I'm the engineer who designed the Gen AI Guardrails system that won the DataIQ Best Responsible AI Program award at the UK's largest retail bank — and I did it while also being the person who ensured it unlocked £20M of value. Both things. Not a trade-off.
          </p>
          <p class="text-deep-earth/70 leading-relaxed">
            I now work fractionally with startups and scale-ups shipping GenAI and agentic systems. I embed 2–3 days/week with your team, build the infrastructure you actually need (guardrails, evals, safety layers, LLMOps), and teach your engineers how to think about safety and reliability in production AI systems.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- What I've Built -->
  <section class="section-padding">
    <div class="container-wide mx-auto">
      <SectionHeader
        label="Experience"
        title="What I've built"
      />

      <div class="mt-16 space-y-12">
        {experience.map((item) => (
          <div class="grid grid-cols-1 lg:grid-cols-4 gap-6 items-start">
            <div class="lg:col-span-1">
              <p class="font-heading font-bold text-forest-deep text-lg">{item.org}</p>
              <p class="text-sage text-sm mt-1">{item.period}</p>
              <p class="text-deep-earth/60 text-sm italic mt-1">{item.role}</p>
            </div>
            <div class="lg:col-span-3">
              <ul class="space-y-2">
                {item.bullets.map((bullet) => (
                  <li class="flex items-start gap-3">
                    <svg class="w-4 h-4 text-sage flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    <span class="text-deep-earth/80 leading-relaxed">{bullet}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- How I Think About AI Safety -->
  <section class="section-padding bg-forest-deep text-soft-cream relative overflow-hidden">
    <div class="container-wide mx-auto relative z-10">
      <SectionHeader
        label="Philosophy"
        title="How I think about AI safety"
        light={true}
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-16">
        {principles.map((principle) => (
          <div class="bg-soft-cream/5 backdrop-blur-sm border border-soft-cream/10 rounded-2xl p-8">
            <h3 class="text-lg font-heading font-semibold text-morning-gold mb-4">
              {principle.title}
            </h3>
            <p class="text-soft-cream/80 leading-relaxed">
              {principle.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Credentials -->
  <section class="section-padding bg-warm-stone/30">
    <div class="container-narrow mx-auto">
      <SectionHeader
        label="Credentials"
        title="Background"
      />

      <div class="mt-12 grid grid-cols-1 md:grid-cols-2 gap-10">
        <div>
          <h3 class="font-heading font-semibold text-forest-deep mb-4">Education</h3>
          <ul class="space-y-3 text-deep-earth/80">
            <li>Ph.D. Theoretical Physics (Cosmology &amp; Applied ML) — University of Cambridge</li>
            <li>MASt Applied Mathematics — University of Cambridge</li>
            <li>M.Sc. Physics (9.98/10 GPA) — Indian Institute of Technology</li>
            <li>B.Sc. Physics — Jadavpur University</li>
          </ul>
        </div>
        <div>
          <h3 class="font-heading font-semibold text-forest-deep mb-4">Recognition</h3>
          <ul class="space-y-3 text-deep-earth/80">
            <li>100 Brilliant Women in AI Ethics 2024</li>
            <li>DataIQ Best Responsible AI Program 2025 (Lloyds Banking Group)</li>
            <li>Published: Patterns, Cell Press (2025)</li>
            <li>Globethics Emerging Leaders in Ethical AI Governance Fellow (2026)</li>
            <li>Real ML Shift Fellow (2026)</li>
            <li>Patents pending: fairness monitoring + privacy-preserving ML (Fujitsu)</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section-padding">
    <div class="container-narrow mx-auto text-center">
      <h2 class="mb-6">If you're shipping AI and need someone to build it safely — let's talk.</h2>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={`${base}/contact`} class="btn-primary">
          Book a 30-minute call
        </a>
        <a href={`${base}/case-studies`} class="btn-secondary">
          See what I've built
          <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
