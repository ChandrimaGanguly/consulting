---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Ship Production AI Safely"
  description="Fractional AI Architect & Enablement Lead. I build guardrails, eval frameworks, and agentic systems that let your team ship production AI safely. Physics PhD, ex-Lloyds Banking Group."
>
  <!-- Hero Section -->
  <section class="relative min-h-[90vh] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-forest-deep via-forest-deep/90 to-sage/80">
      <div class="absolute inset-0 bg-[url('https://images.unsplash.com/photo-1448375240586-882707db888b?auto=format&fit=crop&w=2000&q=80')] bg-cover bg-center opacity-30"></div>
      <div class="hero-overlay absolute inset-0"></div>
    </div>

    <div class="absolute inset-0 opacity-5">
      <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
        <pattern id="topo" x="0" y="0" width="100" height="100" patternUnits="userSpaceOnUse">
          <path d="M0 50 Q25 25, 50 50 T100 50" fill="none" stroke="currentColor" stroke-width="0.5" class="text-soft-cream"/>
        </pattern>
        <rect width="100%" height="100%" fill="url(#topo)"/>
      </svg>
    </div>

    <div class="relative z-10 container-wide mx-auto px-6 md:px-8 text-center">
      <div class="max-w-4xl mx-auto">
        <p class="text-sage text-sm md:text-base tracking-widest uppercase mb-6 animate-fade-in-up opacity-0">
          Fractional AI Architect &amp; Enablement Lead
        </p>

        <h1 class="text-soft-cream mb-6 animate-fade-in-up opacity-0 animation-delay-200">
          Ship production AI safely.<br/>No compromises.
        </h1>

        <p class="text-xl md:text-2xl text-soft-cream/90 max-w-3xl mx-auto mb-6 leading-relaxed animate-fade-in-up opacity-0 animation-delay-400">
          I design and build guardrails, evals, and agentic systems that let your team move fast — without it falling apart in production.
        </p>

        <p class="text-base md:text-lg text-soft-cream/70 max-w-2xl mx-auto mb-12 animate-fade-in-up opacity-0 animation-delay-400">
          Physics PhD (Cambridge). ex-Lloyds Banking Group. Fully remote, 2–3 days/week.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center animate-fade-in-up opacity-0 animation-delay-600">
          <a href={`${base}/contact`} class="btn-primary bg-morning-gold hover:bg-morning-gold/90 text-forest-deep">
            Book a 30-minute call
          </a>
          <a href={`${base}/case-studies`} class="btn-secondary border-soft-cream text-soft-cream hover:bg-soft-cream hover:text-forest-deep">
            See what I've built
          </a>
        </div>
      </div>
    </div>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
      <svg class="w-6 h-6 text-soft-cream/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
      </svg>
    </div>
  </section>

  <!-- Proof Bar -->
  <section class="bg-soft-cream border-b border-warm-stone">
    <div class="container-wide mx-auto px-6 md:px-8 py-10">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 text-center">
        <div>
          <p class="text-3xl font-heading font-bold text-forest-deep mb-1">£20M+</p>
          <p class="text-sm text-deep-earth/70">Value unlocked<br/>at Lloyds Bank</p>
        </div>
        <div>
          <p class="text-3xl font-heading font-bold text-forest-deep mb-1">DataIQ</p>
          <p class="text-sm text-deep-earth/70">Best Responsible<br/>AI Program 2025</p>
        </div>
        <div>
          <p class="text-3xl font-heading font-bold text-forest-deep mb-1">Ph.D.</p>
          <p class="text-sm text-deep-earth/70">Cosmology &amp;<br/>Applied ML</p>
        </div>
        <div>
          <p class="text-3xl font-heading font-bold text-forest-deep mb-1">Cambridge</p>
          <p class="text-sm text-deep-earth/70">MASt Applied<br/>Mathematics</p>
        </div>
      </div>
    </div>
  </section>

  <!-- What I Build -->
  <section class="section-padding" id="services-preview">
    <div class="container-wide mx-auto">
      <SectionHeader
        label="Services"
        title="What I build"
        subtitle="Production artefacts, not strategy decks. I embed with your team, build the infrastructure, and ship it."
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-16">
        <div class="card border-l-4 border-l-sage">
          <h3 class="text-xl font-heading font-semibold text-forest-deep mb-3">Guardrails &amp; Safety Infrastructure</h3>
          <p class="text-deep-earth/70 leading-relaxed">
            I design and implement the safety layer for your GenAI or agentic system — eval harnesses, output monitoring, hallucination detection, prompt injection defence. Built for production, not demos.
          </p>
        </div>

        <div class="card border-l-4 border-l-morning-gold">
          <h3 class="text-xl font-heading font-semibold text-forest-deep mb-3">Agentic Systems Architecture</h3>
          <p class="text-deep-earth/70 leading-relaxed">
            Multi-agent orchestration, tool-calling, state management, and observability — designed so your agents behave predictably in production and you can debug them when they don't.
          </p>
        </div>

        <div class="card border-l-4 border-l-terracotta">
          <h3 class="text-xl font-heading font-semibold text-forest-deep mb-3">AI Enablement Sprints</h3>
          <p class="text-deep-earth/70 leading-relaxed">
            I embed with your dev team for 2–3 days/week and teach them how to build, evaluate, and ship AI systems safely at scale. No slides. Just building.
          </p>
        </div>
      </div>

      <div class="text-center mt-12">
        <a href={`${base}/services`} class="btn-tertiary">
          See all services
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Proof, not promises -->
  <section class="section-padding bg-forest-deep text-soft-cream relative overflow-hidden">
    <div class="container-wide mx-auto relative z-10">
      <SectionHeader
        label="Case Studies"
        title="Proof, not promises."
        light={true}
      />

      <div class="mt-16 space-y-8">
        <!-- Lead case study -->
        <div class="bg-soft-cream/5 border border-soft-cream/10 rounded-2xl p-8 lg:p-10">
          <div class="flex flex-col lg:flex-row gap-8 items-start">
            <div class="flex-1">
              <p class="text-sage text-sm tracking-widest uppercase mb-3">Financial Services · GenAI at Scale</p>
              <h3 class="text-2xl font-heading font-semibold text-soft-cream mb-4">
                Gen AI Guardrails at the UK's largest retail bank
              </h3>
              <p class="text-soft-cream/80 leading-relaxed mb-6">
                Designed and tech-led the full Gen AI Assurance framework and Guardrails toolkit — eval harnesses, safety layers, hallucination monitoring, compliance documentation. Scaled to cover 50+ AI implementations across the organisation.
              </p>
              <div class="bg-soft-cream/10 rounded-lg p-5 border border-soft-cream/20">
                <p class="text-morning-gold text-sm uppercase tracking-wide mb-2 font-semibold">Impact</p>
                <p class="text-soft-cream font-semibold">£20M of value unlocked across GenAI implementations. DataIQ Best Responsible AI Program 2025.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Secondary case study -->
        <div class="bg-soft-cream/5 border border-soft-cream/10 rounded-2xl p-8">
          <p class="text-sage text-sm tracking-widest uppercase mb-3">AI Safety · High-Stakes Deployment</p>
          <h3 class="text-xl font-heading font-semibold text-soft-cream mb-3">
            Safety evaluation framework for Vida (herEthicalAI)
          </h3>
          <p class="text-soft-cream/70 leading-relaxed">
            LLM system deployed to police forces detecting victim-blaming language and abuse patterns in court documents. Designing the core eval harness and adversarial eval tooling for a domain where false negatives have direct harm consequences for real people.
          </p>
        </div>
      </div>

      <div class="text-center mt-10">
        <a href={`${base}/case-studies`} class="btn-secondary border-soft-cream text-soft-cream hover:bg-soft-cream hover:text-forest-deep">
          See all case studies
        </a>
      </div>
    </div>
  </section>

  <!-- Insights Section -->
  <section class="section-padding">
    <div class="container-wide mx-auto">
      <SectionHeader
        label="Insights"
        title="When is AI Responsible?"
        subtitle="Thoughts on building production AI systems safely, evaluating LLMs rigorously, and what responsible AI actually means in practice."
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-16">
        {[1, 2, 3].map((_i) => (
          <article class="card group cursor-pointer hover:border-sage/50">
            <div class="aspect-video bg-warm-stone rounded-lg mb-6 flex items-center justify-center">
              <svg class="w-12 h-12 text-sage/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/>
              </svg>
            </div>
            <p class="text-sm text-sage mb-2">On Substack</p>
            <h3 class="text-xl font-heading font-semibold text-forest-deep mb-3 group-hover:text-sage transition-colors">
              Insights from the Newsletter
            </h3>
            <p class="text-deep-earth/70">
              Subscribe to "When is AI responsible?" on Substack — evals, guardrails, agentic safety, and what actually happens when safety is an afterthought.
            </p>
          </article>
        ))}
      </div>

      <div class="text-center mt-12">
        <a
          href="https://chandrimaganguly.substack.com/s/when-is-ai-responsible"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary"
        >
          Subscribe on Substack
          <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="section-padding bg-gradient-to-br from-warm-stone to-sage/20 relative overflow-hidden">
    <div class="absolute top-0 right-0 w-96 h-96 bg-sage/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-64 h-64 bg-morning-gold/10 rounded-full blur-3xl"></div>

    <div class="container-narrow mx-auto text-center relative z-10">
      <h2 class="mb-6">Ready to ship AI safely?</h2>
      <p class="text-xl text-deep-earth/80 mb-8 max-w-2xl mx-auto">
        Book a 30-minute call. I'll tell you honestly whether I can help and what it would look like.
      </p>
      <a href={`${base}/contact`} class="btn-primary">
        Book a 30-minute call
      </a>
    </div>
  </section>
</BaseLayout>
